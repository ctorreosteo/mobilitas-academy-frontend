@@ -0,0 +1,35 @@
+package expo.modules.plugin
+
+import java.io.File
+
+/**
+ * Resolves the Node binary when the Gradle daemon has no nvm/Homebrew PATH
+ * (typical for Android Studio). Reads NODE_BINARY, then android/local.properties
+ * `node.executable`.
+ */
+object NodeBinary {
+  fun resolve(workingDir: File? = null): String {
+    val fromEnv = System.getenv("NODE_BINARY")?.trim()
+    if (!fromEnv.isNullOrEmpty() && File(fromEnv).canExecute()) {
+      return fromEnv
+    }
+
+    var dir: File? = workingDir ?: File(System.getProperty("user.dir"))
+    var depth = 0
+    while (dir != null && depth < 6) {
+      val local = File(dir, "local.properties")
+      if (local.isFile) {
+        val line = local.readLines().firstOrNull { it.startsWith("node.executable=") }
+        if (line != null) {
+          val path = line.substringAfter("=").trim()
+          if (path.isNotEmpty() && File(path).canExecute()) {
+            return path
+          }
+        }
+      }
+      dir = dir.parentFile
+      depth++
+    }
+    return "node"
+  }
+}
